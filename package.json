{
  "name": "local-first-doc-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, offline-capable collaborative document editor (Phase 1: editor + offline persistence).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yjs": "^13.6.31",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "@tiptap/react": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-collaboration": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "next-auth": "^5.0.0-beta.31",
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "zod": "^3.25.76",
    "@hocuspocus/provider": "^4.3.0",
    "jose": "^6.2.3",
    "ai": "^7.0.18",
    "@ai-sdk/google": "^4.0.8",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prisma": "^6.19.3",
    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9"
  }
}
