# =============================================================================
# Environment variables — copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (it is gitignored).
# =============================================================================


DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# AUTH_SECRET: random 32+ byte secret used to sign/encrypt JWT sessions.
#   Generate with:  npx auth secret    (or)   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Canonical app URL. Required in production; optional locally.
AUTH_URL="http://localhost:3000"

# Trust the host header (needed on some platforms / behind proxies).
AUTH_TRUST_HOST="true"

# Google OAuth credentials (for Google login). Get them at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google Generative AI API key (for Gemini model). Get it at https://console.cloud.google.com/apis/credentials
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# Realtime sync server — the browser connects here for live collaboration.
#   NEXT_PUBLIC_SYNC_WS_URL: public WS URL of the sync-server (ws:// locally,
#     wss:// in production). Leave unset to disable realtime (HTTP sync still works).
#   SYNC_JWT_SECRET: signs the short-lived access tokens the relay verifies.
#     MUST be identical to SYNC_JWT_SECRET in sync-server/.env.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SYNC_WS_URL="ws://localhost:1234"
SYNC_JWT_SECRET="replace-with-a-shared-secret-matching-the-sync-server"
