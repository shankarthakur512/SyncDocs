# =============================================================================
# Sync server environment — copy to `.env` and fill in.
# =============================================================================

# Port the WebSocket server listens on (Railway/Render set PORT automatically).
PORT=1234

# MUST exactly match SYNC_JWT_SECRET in the Next.js app's .env.
# This shared secret is how the relay trusts the app-issued access tokens.
# Generate with: openssl rand -base64 32
SYNC_JWT_SECRET="replace-with-the-same-secret-as-the-next-app"
